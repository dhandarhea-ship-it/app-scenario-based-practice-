class Mobile:
    def __init__(self, brand, model, price):
        self.brand = brand
        self.model = model
        self.price = price

    def get_category(self):
        if self.price >= 60000:
            return "Premium"
        elif self.price >= 20000:
            return "Mid-range"
        else:
            return "Budget"

    def display(self):
        print("Brand:", self.brand)
        print("Model:", self.model)
        print("Price: ₹", self.price)
        print("Category:", self.get_category())
        print("-" * 30)


class Store:
    def __init__(self):
        self.mobiles = []

    def add_mobile(self, mobile):
        self.mobiles.append(mobile)

    def display_mobiles(self):
        for mobile in self.mobiles:
            mobile.display()


store = Store()

store.add_mobile(Mobile("Apple", "iPhone 15", 70000))
store.add_mobile(Mobile("Samsung", "Galaxy A55", 35000))
store.add_mobile(Mobile("Redmi", "Note 13", 15000))

store.display_mobiles()
