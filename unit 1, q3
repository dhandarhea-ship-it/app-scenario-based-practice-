class Book:
    def __init__(self, book_id, title, author, price):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.price = price

    def get_category(self):
        if self.price >= 1000:
            return "Premium"
        else:
            return "Standard"

    def display(self):
        print("Book ID:", self.book_id)
        print("Title:", self.title)
        print("Author:", self.author)
        print("Price: ₹", self.price)
        print("Category:", self.get_category())
        print("-" * 30)


class Library:
    def __init__(self):
        self.books = []

    def add_book(self, book):
        self.books.append(book)

    def display_books(self):
        for book in self.books:
            book.display()


library = Library()

library.add_book(Book(101, "Python Basics", "John Smith", 1200))
library.add_book(Book(102, "Data Structures", "Robert Brown", 800))
library.add_book(Book(103, "Machine Learning", "David Lee", 1500))

library.display_books()
