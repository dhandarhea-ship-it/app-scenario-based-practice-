class Course:
    def __init__(self, course_name, duration, fee):
        self.course_name = course_name
        self.duration = duration
        self.fee = fee

    def get_category(self):
        if self.duration <= 6:
            return "Short-Term"
        else:
            return "Long-Term"

    def display(self):
        print("Course Name:", self.course_name)
        print("Duration:", self.duration, "months")
        print("Fee: ₹", self.fee)
        print("Category:", self.get_category())
        print("-" * 30)


class Institute:
    def __init__(self):
        self.courses = []

    def add_course(self, course):
        self.courses.append(course)

    def display_courses(self):
        for course in self.courses:
            course.display()


institute = Institute()

institute.add_course(Course("Python Programming", 3, 15000))
institute.add_course(Course("Data Science", 12, 60000))
institute.add_course(Course("Web Development", 6, 25000))

institute.display_courses()
