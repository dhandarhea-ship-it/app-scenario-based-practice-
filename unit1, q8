class Movie:
    def __init__(self, movie_name, rating, ticket_price):
        self.movie_name = movie_name
        self.rating = rating
        self.ticket_price = ticket_price

    def get_category(self):
        if self.rating >= 8:
            return "Hit"
        elif self.rating >= 5:
            return "Average"
        else:
            return "Flop"

    def display(self):
        print("Movie Name:", self.movie_name)
        print("Rating:", self.rating)
        print("Ticket Price: ₹", self.ticket_price)
        print("Category:", self.get_category())
        print("-" * 30)


class Cinema:
    def __init__(self):
        self.movies = []

    def add_movie(self, movie):
        self.movies.append(movie)

    def display_movies(self):
        for movie in self.movies:
            movie.display()


cinema = Cinema()

cinema.add_movie(Movie("Movie A", 9.0, 250))
cinema.add_movie(Movie("Movie B", 6.5, 200))
cinema.add_movie(Movie("Movie C", 4.0, 150))

cinema.display_movies()
